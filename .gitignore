.env
.env.local
.env.production
.env.staging
*.pyc
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.DS_Store
.idea/
# Ignore most of .vscode but keep the shared interpreter + test settings
.vscode/*
!.vscode/settings.json
*.log

# TLS / signing keys
*.pem
*.key
*.crt
*.p12

# Credentials and sensitive files
**/credentials.md
CREDENTIALS.md

# Azure deployment state (generated by scripts/azure-deploy.sh)
.azure-deploy-info

# Runtime-generated reports (keep folder, ignore contents)
reports/*
!reports/.gitkeep

# Archive: ignore heavy generated/data artifacts
archive/ml_experiments/artifacts/*
archive/ml_experiments/data/*
archive/data_exploration/*
!archive/**/.gitkeep

# Catch-all for env files
*.env

# Secrets directory
secrets/

# Node modules
node_modules/

# Test secret files (any name starting with test_secret)
test_secret*

# Temp files
patch.json
patch_result.txt
app_config.json
app_config.txt
logs_output.txt
logs_out.txt
