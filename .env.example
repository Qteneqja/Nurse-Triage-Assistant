# ============================================================
# Nurse Triage Assistant - Environment Configuration (Phase 5)
# ============================================================
# Copy this file to .env and fill in the required values.
# Do NOT commit the .env file to version control.
#
# In production, set these as platform env vars (Render, Railway, ECS, etc.).
# The app does NOT require a .env file - it reads os.environ directly.

# --- Environment profile ---
# development | staging | production
APP_ENV=development

# --- Storage Configuration ---
# "memory" for development, "postgres" for staging/production
STORAGE_BACKEND=memory
# Required when STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://triage:triage_pass@localhost:5432/triage_db

# --- PHI Control ---
# Set to "true" to store raw patient text in database
# Default: false (no PHI stored)
STORE_PHI=false

# --- DeepSeek LLM Configuration (required in staging/production) ---
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Twilio Configuration (required for phone calls) ---
TWILIO_WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io
TWILIO_AUTH_TOKEN=
# Twilio signature validation - auto-enabled in staging/prod.
# Set to "true" to enable in dev for local testing with ngrok.
TWILIO_VALIDATE_SIGNATURE=false
# Phone number to warm-transfer callers to after triage (e.g. +18005551234)
NURSE_TRANSFER_NUMBER=

# --- Voice pipeline (telephony transport) ---
# "gather" = legacy Twilio <Gather>/TwiML request-response path.
# "conversation_relay" = streaming Twilio ConversationRelay WebSocket path.
# Instant rollback = set back to "gather". Default stays "gather" until the
# ConversationRelay path is feature-complete and the latency gate passes.
VOICE_PIPELINE=gather
# ConversationRelay TTS/output mode:
#   "azure_play" = keep the current Azure voice via a CR <play> MP3 URL (no
#                  voice change, no streaming) — the no-regression default.
#   "cr_native"  = stream text tokens; Twilio CR renders TTS (changes the voice).
VOICE_OUTPUT_MODE=azure_play
# Explicit wss:// URL Twilio opens for ConversationRelay. Leave blank to derive
# it from TWILIO_WEBHOOK_BASE_URL + /api/v1/voice/relay.
CONVERSATION_RELAY_WSS_URL=
# Shared secret appended to the wss URL (?token=...) to auth the WS upgrade.
# Leave blank to disable the check (dev only). NEVER commit a real value.
CONVERSATION_RELAY_WS_TOKEN=
# ConversationRelay native STT/TTS config (CR TwiML attrs + cr_native output).
# CR_TTS_VOICE = the Birchwood "Aurora" ElevenLabs voice (used when
# VOICE_OUTPUT_MODE=cr_native). The ElevenLabs API key is configured on the
# Twilio side (ConversationRelay TTS credentials), never here.
CR_TTS_PROVIDER=ElevenLabs
CR_TTS_VOICE=zGjIP4SZlMnY9m93k97r
CR_TRANSCRIPTION_PROVIDER=Deepgram
CR_SPEECH_MODEL=nova-2
# Max seconds to let a closing/transfer/fail-closed message finish playing before
# ConversationRelay ends the session (it cuts off in-flight audio on `end`, which
# otherwise drops the goodbye and the call goes silent). 0 disables the wait.
CR_FINAL_SPEECH_SETTLE_MAX_S=30
# Perceived-latency: speak a short pre-approved acknowledgment ("Okay.", "Got it.")
# the instant the caller finishes, while the gated LLM turn computes behind it. The
# real reply is still safety-gated. Off by default; A/B it on the line.
CR_INSTANT_ACK=false

# --- LLM Settings ---
LLM_TIMEOUT=30

# --- Mock mode - set to "true" to skip real LLM calls (for testing) ---
USE_MOCK_LLM=false

# --- Legacy env compat (prefer APP_ENV going forward) ---
ENVIRONMENT=development

# --- Protocol Governance ---
PROTOCOL_VERSION=v1

# --- Platform Workflow Routing ---
DEFAULT_VERTICAL_KEY=healthcare
DEFAULT_WORKFLOW_ID=healthcare_triage_v1
DEFAULT_WORKFLOW_VERSION=v1
# In production, enable only while using the legacy/default healthcare route
# before phone_numbers routing data is seeded.
ENABLE_DEFAULT_HEALTHCARE_ROUTE=true
# Generic replacement for ENABLE_DEFAULT_HEALTHCARE_ROUTE. Prefer this for new deploys.
ENABLE_DEFAULT_WORKFLOW_ROUTE=true
# Workflow hints are useful in development but should stay false in production.
ENABLE_WORKFLOW_HINT_ROUTE=false

# Generic config-driven phone routing (PR 3): JSON object mapping an E.164
# number to any registered workflow_id. Checked before the per-vertical
# phone number vars below. Example:
#   WORKFLOW_PHONE_ROUTES={"+15555550150": "towing_followup_v1"}
WORKFLOW_PHONE_ROUTES=
# Operator drop-in directory of spec-defined workflow *.json files
# (validated against WorkflowSpec; invalid files rejected at startup).
EXTRA_WORKFLOW_DEFINITIONS_DIR=

# --- Post-call enrichment (shadow mode; OFF the live call path) ---
# Master switch — default false: zero new code paths, zero tokens.
ENRICHMENT_ENABLED=false
# Enrichment LLM provider (provider-agnostic; live calls use no LLM).
LLM_PROVIDER=deepseek
# redact (default): PII tokenized before text leaves the system.
# raw: full text sent to the provider — privacy review required first
# (docs/ENRICHMENT_DATA_FLOW.md); logs a startup warning.
ENRICHMENT_PII_MODE=redact
# Per-feature flags (only consulted when ENRICHMENT_ENABLED=true).
ENRICH_NORMALIZE=true
ENRICH_SUMMARY=true
ENRICH_QA=true
ENRICH_FOLLOWUP=true
ENRICH_ROUTING=true
ENRICH_INSIGHTS=true
# Below this many enriched calls, insights reports "insufficient data".
ENRICH_INSIGHTS_MIN_CALLS=30

# --- Default route bootstrap ---
DEFAULT_ORGANIZATION_NAME=Default Healthcare Organization
DEFAULT_ORGANIZATION_SLUG=default-healthcare
DEFAULT_TWILIO_PHONE_NUMBER=
# Phase 13 placeholder phone route for insurance FNOL local/dev testing.
# Production should seed real phone_numbers rows instead of relying on this.
INSURANCE_FNOL_PHONE_NUMBER=+15555550130
# Temporary shared-number menu for routing calls to healthcare, insurance, or
# automotive collision. Set SHARED_NUMBER_VERTICAL_MENU_PHONE_NUMBER to scope
# the menu to one phone number, or leave it blank to apply to all inbound
# numbers while enabled.
ENABLE_SHARED_NUMBER_VERTICAL_MENU=false
SHARED_NUMBER_VERTICAL_MENU_PHONE_NUMBER=
# Phase 14 fake placeholder route for ORCA's Birchwood Collision demo workflow.
# Do not replace with a production Birchwood number until routing is approved.
BIRCHWOOD_COLLISION_PHONE_NUMBER=+15555550140
# Which collision workflow the Birchwood number uses. Default =
# birchwood_collision_intake_v1 (the live pilot flow the Aurora voice pass
# targets). Set to birchwood_collision_intake_min_v1 for the separate
# minimal-only package. (A DB phone_numbers route, if present, takes precedence.)
BIRCHWOOD_COLLISION_WORKFLOW_ID=birchwood_collision_intake_v1
# Birchwood conversational intake (premium tier). true = a gated-LLM fluid
# conversation; false (default) = the cheaper deterministic scripted Q&A. Safety
# is identical either way (every utterance gated, injury reflex on, disposition
# deterministic). Flip to false to downgrade a client and save LLM cost.
BIRCHWOOD_CONVERSATIONAL_INTAKE=false
# TODO(stakeholder-confirmation): confirm exact Birchwood collision locations.
BIRCHWOOD_COLLISION_LOCATION_1=BIRCHWOOD_COLLISION_LOCATION_1
BIRCHWOOD_COLLISION_LOCATION_2=BIRCHWOOD_COLLISION_LOCATION_2
BIRCHWOOD_COLLISION_LOCATION_3=BIRCHWOOD_COLLISION_LOCATION_3
BIRCHWOOD_COLLISION_LUXURY_LOCATION=BIRCHWOOD_COLLISION_LUXURY_LOCATION
BIRCHWOOD_COLLISION_LUXURY_BRANDS=Audi,Porsche,BMW,Mercedes-Benz,Lexus,Land Rover,Jaguar,Genesis,Acura,Cadillac,Infiniti,Volvo
# Birchwood voice UX refinement. Short factual prompts stay tight, while the
# incident-description prompt gets a longer speech window so callers can tell
# the collision story without being cut off.
BIRCHWOOD_SHORT_FIELD_TIMEOUT_SECONDS=5
# speechTimeout for Birchwood short-answer stages: "3" waits a fixed 3s of
# silence after the caller stops speaking (forgiving, but 3s of dead air per
# scripted turn); "auto" end-points adaptively (snappier, may clip pauses).
BIRCHWOOD_SHORT_FIELD_SPEECH_TIMEOUT=3
BIRCHWOOD_NARRATIVE_TIMEOUT_SECONDS=15
BIRCHWOOD_NARRATIVE_SPEECH_TIMEOUT_SECONDS=auto
BIRCHWOOD_ALLOW_LONG_INCIDENT_DESCRIPTION=true
# Birchwood-specific Azure TTS profile. Keep these configurable because voice
# availability can vary by region. Leave blank to fall back to AZURE_TTS_VOICE.
# Store AZURE_SPEECH_KEY in Key Vault / Container App secret refs in production.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=canadacentral
# Optional Azure Blob storage for persistent reports / TTS audio hosting.
# Store the connection string as a Key Vault / Container App secret ref in
# production. Leave empty to disable.
AZURE_STORAGE_CONNECTION_STRING=
# Blob container name; only used when AZURE_STORAGE_CONNECTION_STRING is set.
AZURE_BLOB_CONTAINER=triage-reports
AZURE_TTS_VOICE=en-US-Bree:DragonHDLatestNeural
BIRCHWOOD_AZURE_TTS_VOICE=en-US-Bree:DragonHDLatestNeural
BIRCHWOOD_AZURE_TTS_RATE=+3%
BIRCHWOOD_AZURE_TTS_PITCH=+0%
BIRCHWOOD_AZURE_TTS_STYLE=
BIRCHWOOD_AZURE_TTS_BREAK_MS=250
# Aurora naturalness pass: expressive SSML (varied inline breaks) for the
# Birchwood voice only. Set false to fall back to the uniform-pause rendering.
# Healthcare is unaffected either way.
BIRCHWOOD_TTS_EXPRESSIVE=true

# --- Triage Thresholds ---
# Min confidence score (0-1) below which system escalates to human nurse
CONFIDENCE_MIN_THRESHOLD=0.60
# Weighted red-flag score (integer) at/above which pre-check escalates to URGENT
REDFLAG_SCORE_THRESHOLD=10
# DEPRECATED aliases (emit DeprecationWarning when used; leave unset):
# CONFIDENCE_THRESHOLD=        -> use CONFIDENCE_MIN_THRESHOLD
# ESCALATION_SCORE_THRESHOLD=  -> use REDFLAG_SCORE_THRESHOLD

# --- Security ---
RATE_LIMIT=60/minute
# FastAPI-served dashboard/admin shell. Local development does not require
# the token, but staging/production dashboard API calls do.
DASHBOARD_ENABLED=true
DASHBOARD_ADMIN_TOKEN=
# Minimum DASHBOARD_ADMIN_TOKEN length enforced at startup in production
DASHBOARD_ADMIN_TOKEN_MIN_LENGTH=32
# Show structured contact fields (name/phone/email/address) on NON-healthcare
# intake records behind the dashboard auth gate (the shop needs them to call
# back). Healthcare records stay fully masked regardless. Set false to mask.
DASHBOARD_RECORDS_SHOW_CONTACT=true
# DEPRECATED alias of DASHBOARD_ADMIN_TOKEN (read only when the token is unset;
# leave unset):
# ADMIN_API_KEY=
# Set to "true" only if behind a trusted reverse proxy (nginx, ALB, etc.)
TRUST_PROXY_HEADERS=false
# Optional full Content-Security-Policy header override; empty uses the
# built-in default policy.
SECURITY_CSP=
# frame-ancestors directive for the default CSP; ignored when SECURITY_CSP set.
SECURITY_FRAME_ANCESTORS='none'
# Comma-separated allowed origins for CORS. Leave empty for defaults:
# - dev: allow all (*)
# - staging/prod: allow none (CORS headers omitted)
CORS_ALLOWED_ORIGINS=

# --- Logging & Observability ---
# "json" for structured JSON logging, "text" for human-readable
LOG_FORMAT=json
# Optional Sentry error-monitoring DSN. Leave empty to disable Sentry entirely.
# PII scrubbing is enforced in src/observability/sentry_integration.py.
SENTRY_DSN=

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database migrations ---
# Set to "true" to auto-run Alembic upgrade head at startup (idempotent)
RUN_MIGRATIONS_ON_STARTUP=false

# --- Docker Compose ---
POSTGRES_PASSWORD=triage_pass
